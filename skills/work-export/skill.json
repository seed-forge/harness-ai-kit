{
  "namespace": "work",
  "id": "work-export",
  "name": "work-export",
  "owner": "team",
  "version": "0.2.6",
  "status": "trial",
  "entry": "SKILL.md",
  "package_type": "skill",
  "tags": [
    "work",
    "office",
    "document",
    "outflow",
    "export"
  ],
  "summary": "办公文档通用 Outflow 编排：从内容（Markdown/数据/大纲）调度社区上游技能生成目标格式文档（docx/pdf/xlsx/pptx）。",
  "compatible_clients": [
    "codex",
    "claude-code",
    "cursor",
    "qoder"
  ],
  "installation": {
    "default_scope": "global"
  },
  "dependencies": [
    {
      "type": "skill",
      "namespace": "community",
      "id": "docx",
      "source_url": "https://github.com/anthropics/skills/tree/main/skills/docx",
      "version": "latest",
      "scope": "required"
    },
    {
      "type": "skill",
      "namespace": "community",
      "id": "pdf",
      "source_url": "https://github.com/anthropics/skills/tree/main/skills/pdf",
      "version": "latest",
      "scope": "required"
    },
    {
      "type": "skill",
      "namespace": "community",
      "id": "xlsx",
      "source_url": "https://github.com/anthropics/skills/tree/main/skills/xlsx",
      "version": "latest",
      "scope": "required"
    },
    {
      "type": "skill",
      "namespace": "community",
      "id": "pptx",
      "source_url": "https://github.com/anthropics/skills/tree/main/skills/pptx",
      "version": "latest",
      "scope": "required"
    }
  ],
  "sources": {
    "preferred": [
      "team-skill-registry",
      "repo-checkout"
    ],
    "allow_fallback": true
  },
  "companion_docs": {
    "usage": "USAGE.md",
    "example_required": false
  },
  "environment": {
    "dependency_groups": [],
    "system": [
      {
        "name": "node",
        "command": "node --version"
      },
      {
        "name": "python",
        "command": "python --version"
      }
    ],
    "python_strategy": "project-venv",
    "python_packages": [
      "reportlab",
      "openpyxl",
      "pypdf"
    ],
    "fonts": [],
    "verify_commands": []
  },
  "runtime_requirements": [
    "Always verify output after export — open in Office/WPS or render to PNG.",
    "For Chinese documents, default font: Source Han Sans or Microsoft YaHei.",
    "Multi-format export: execute source document first, then derived exports."
  ],
  "post_install_hints": [
    "Verify node and python are available."
  ],
  "updated_at": "2026-08-14",
  "execution_context": {
    "ide": true,
    "server": false,
    "requires_codebase": false,
    "requires_browser": false,
    "requires_interactive": false,
    "server_runtime": null
  }
